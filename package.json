{
  "name": "importadora-erp",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "migrate:pos": "pnpm --filter backend migrate:pos",
    "create:admin": "pnpm --filter backend create:admin",
    "init:db": "pnpm --filter backend init:db"
  }
}
